{
  "name": "pi-context-scribe",
  "version": "0.1.0",
  "description": "A Pi extension for independently configured conversation compaction.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "thias",
  "keywords": [
    "pi-package",
    "pi-extension",
    "compaction"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
